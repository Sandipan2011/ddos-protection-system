    alert_manager.add_callback(print_alert)
    alert_manager.start(eval_interval=5)
    print("✓ Alert manager started")
    
    # Simulate metrics
    for i in range(10):
        collector.record_packet("tcp", "inbound", 1500)
        collector.record_attack("SYN_FLOOD", "high", True)

"""
AI-Based Threat Scoring Module for DDoS Protection System
Uses machine learning for anomaly detection and behavioral analysis
"""

import threading
import time
import logging
import hashlib
import json
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Tuple, Any
from dataclasses import dataclass, field
from enum import Enum
from collections import defaultdict, deque
import math

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


class ThreatLevel(Enum):
    LOW = "low"
    MEDIUM = "medium"
    HIGH = "high"
    CRITICAL = "critical"


@dataclass
class ThreatFeatures:
    """Feature vector for threat scoring"""
    packet_rate: float = 0.0
    bytes_rate: float = 0.0
    connection_rate: float = 0.0
    syn_ratio: float = 0.0
    udp_ratio: float = 0.0
    icmp_ratio: float = 0.0
    fragment_ratio: float = 0.0
    port_distribution: float = 0.0
    geo_risk_score: float = 0.0
    reputation_score: float = 0.0
    behavioral_anomaly: float = 0.0
    temporal_anomaly: float = 0.0
    
    def to_vector(self) -> List[float]:
        return [
            self.packet_rate, self.bytes_rate, self.connection_rate,
            self.syn_ratio, self.udp_ratio, self.icmp_ratio,
            self.fragment_ratio, self.port_distribution, self.geo_risk_score,
            self.reputation_score, self.behavioral_anomaly, self.temporal_anomaly
        ]
    
    @classmethod
    def from_dict(cls, data: Dict) -> 'ThreatFeatures':
        return cls(**{k: v for k, v in data.items() if k in cls.__dataclass_fields__})


@dataclass
class IPThreatProfile:
    """Threat profile for an IP address"""
    ip: str
    first_seen: datetime
    last_seen: datetime
    total_packets: int
    total_bytes: int
    attack_types: List[str]
    blocked_count: int
    features: ThreatFeatures
    threat_score: float = 0.0
    threat_level: ThreatLevel = ThreatLevel.LOW
    is_whitelisted: bool = False
    is_blacklisted: bool = False
    
    def to_dict(self) -> Dict[str, Any]:
        return {
            "ip": self.ip,
            "first_seen": self.first_seen.isoformat(),
            "last_seen": self.last_seen.isoformat(),
            "total_packets": self.total_packets,
            "total_bytes": self.total_bytes,
            "attack_types": self.attack_types,
            "blocked_count": self.blocked_count,
            "features": {
                "packet_rate": self.features.packet_rate,
                "bytes_rate": self.features.bytes_rate,
                "syn_ratio": self.features.syn_ratio,
                "threat_score": self.threat_score,
                "threat_level": self.threat_level.value
            }
        }


class StatisticalAnalyzer:
    """Statistical analysis for anomaly detection"""
    
    def __init__(self, window_size: int = 1000):
        self.window_size = window_size
        self.values: deque = deque(maxlen=window_size)
        self.lock = threading.Lock()
        
    def add_value(self, value: float):
        with self.lock:
            self.values.append(value)
    
    def get_mean(self) -> float:
        with self.lock:
            if not self.values:
                return 0.0
            return sum(self.values) / len(self.values)
    
    def get_std(self) -> float:
        with self.lock:
            if len(self.values) < 2:
                return 0.0
            mean = self.get_mean()
            variance = sum((x - mean) ** 2 for x in self.values) / len(self.values)
            return math.sqrt(variance)
    
    def get_z_score(self, value: float) -> float:
        std = self.get_std()
        if std == 0:
            return 0.0
        return (value - self.get_mean()) / std
    
    def get_percentile(self, p: float) -> float:
        with self.lock:
            if not self.values:
                return 0.0
            sorted_vals = sorted(self.values)
            idx = int(len(sorted_vals) * p / 100)
            return sorted_vals[min(idx, len(sorted_vals) - 1)]
    
    def is_anomaly(self, value: float, threshold: float = 3.0) -> bool:
        """Check if value is anomalous (Z-score based)"""
        return abs(self.get_z_score(value)) > threshold


class BehavioralAnalyzer:
    """Behavioral pattern analysis"""
    
    def __init__(self):
        self.ip_profiles: Dict[str, IPThreatProfile] = {}
        self.global_stats = {
            "total_ips": 0,
            "total_packets": 0,
            "total_bytes": 0,
            "attack_types": defaultdict(int)
        }
        self.lock = threading.Lock()
        
        # Statistical analyzers for global metrics
        self.packet_rate_analyzer = StatisticalAnalyzer(1000)
        self.bytes_rate_analyzer = StatisticalAnalyzer(1000)
        self.syn_ratio_analyzer = StatisticalAnalyzer(1000)
        
        # Known attack signatures
        self.attack_signatures = {
            "SYN_FLOOD": {"syn_ratio": (0.8, 1.0), "packet_rate": (1000, float('inf'))},
            "UDP_FLOOD": {"udp_ratio": (0.7, 1.0), "packet_rate": (1000, float('inf'))},
            "ICMP_FLOOD": {"icmp_ratio": (0.5, 1.0), "packet_rate": (500, float('inf'))},
            "ACK_FLOOD": {"packet_rate": (500, float('inf'))},
            "RST_FLOOD": {"packet_rate": (500, float('inf'))},
            "FRAGMENTATION": {"fragment_ratio": (0.3, 1.0)},
            "PORT_SCAN": {"port_distribution": (0.1, 0.3), "connection_rate": (100, float('inf'))},
            "SLOWLORIS": {"connection_rate": (1, 10), "packet_rate": (10, 50)},
            "HTTP_FLOOD": {"packet_rate": (100, 1000)},
        }
        
    def update_ip_profile(self, ip: str, packet_size: int = 64, protocol: str = "tcp"):
        """Update profile for an IP address"""
        with self.lock:
            now = datetime.now()
            
            if ip not in self.ip_profiles:
                self.ip_profiles[ip] = IPThreatProfile(
                    ip=ip,
                    first_seen=now,
                    last_seen=now,
                    total_packets=1,
                    total_bytes=packet_size,
                    attack_types=[],
                    blocked_count=0,
                    features=ThreatFeatures()
                )
                self.global_stats["total_ips"] += 1
            else:
                profile = self.ip_profiles[ip]
                profile.last_seen = now
                profile.total_packets += 1
                profile.total_bytes += packet_size
            
            self.global_stats["total_packets"] += 1
            self.global_stats["total_bytes"] += packet_size
    
    def record_attack(self, ip: str, attack_type: str):
        """Record an attack from an IP"""
        with self.lock:
            if ip in self.ip_profiles:
                profile = self.ip_profiles[ip]
                profile.attack_types.append(attack_type)
                profile.blocked_count += 1
            self.global_stats["attack_types"][attack_type] += 1
    
    def compute_threat_score(self, ip: str) -> Tuple[float, ThreatLevel]:
        """
        Compute threat score for an IP using ML-like scoring
        """
        with self.lock:
            if ip not in self.ip_profiles:
                return 0.0, ThreatLevel.LOW
            
            profile = self.ip_profiles[ip]
            features = profile.features
            
            # Base score from historical behavior
            base_score = 0.0
            
            # Attack history (0-30 points)
            base_score += min(len(profile.attack_types) * 5, 30)
            
            # Blocked count (0-20 points)
            base_score += min(profile.blocked_count * 2, 20)
            
            # Packet rate anomaly (0-20 points)
            if features.packet_rate > 0:
                z_score = self.packet_rate_analyzer.get_z_score(features.packet_rate)
                base_score += min(abs(z_score) * 5, 20)
            
            # SYN ratio (0-15 points) - high SYN ratio indicates SYN flood
            if features.syn_ratio > 0.5:
                base_score += min((features.syn_ratio - 0.5) * 30, 15)
            
            # UDP ratio (0-15 points) - high UDP ratio indicates UDP flood
            if features.udp_ratio > 0.5:
                base_score += min((features.udp_ratio - 0.5) * 30, 15)
            
            # Fragmentation (0-10 points)
            if features.fragment_ratio > 0.1:
                base_score += min(features.fragment_ratio * 100, 10)
            
            # Port distribution (0-10 points)
            if features.port_distribution > 0.2:
                base_score += min(features.port_distribution * 50, 10)
            
            # Behavioral anomaly (0-20 points)
            base_score += features.behavioral_anomaly * 20
            
            # Temporal anomaly (0-15 points)
            base_score += features.temporal_anomaly * 15
            
            # Geo risk (0-10 points)
            base_score += features.geo_risk_score * 10
            
            # Reputation (0-10 points)
            base_score += (1.0 - features.reputation_score) * 10
            
            # Cap at 100
            threat_score = min(base_score, 100.0)
            
            # Determine threat level
            if threat_score >= 80:
                threat_level = ThreatLevel.CRITICAL
            elif threat_score >= 60:
                threat_level = ThreatLevel.HIGH
            elif threat_score >= 40:
                threat_level = ThreatLevel.MEDIUM
            else:
                threat_level = ThreatLevel.LOW
            
            profile.threat_score = threat_score
            profile.threat_level = threat_level
            
            return threat_score, threat_level
    
    def detect_attack_type(self, features: ThreatFeatures) -> Optional[str]:
        """Detect attack type based on features"""
        best_match = None
        best_score = 0.0
        
        for attack_type, signatures in self.attack_signatures.items():
            score = 0.0
            matched = 0
            
            if "syn_ratio" in signatures and features.syn_ratio >= signatures["syn_ratio"][0]:
                score += features.syn_ratio
                matched += 1
            
            if "udp_ratio" in signatures and features.udp_ratio >= signatures["udp_ratio"][0]:
                score += features.udp_ratio
                matched += 1
            
            if "icmp_ratio" in signatures and features.icmp_ratio >= signatures["icmp_ratio"][0]:
                score += features.icmp_ratio
                matched += 1
            
            if "fragment_ratio" in signatures and features.fragment_ratio >= signatures["fragment_ratio"][0]:
                score += features.fragment_ratio
                matched += 1
            
            if "port_distribution" in signatures:
                pd = features.port_distribution
                min_p, max_p = signatures["port_distribution"]
                if min_p <= pd <= max_p:
                    score += 1.0
                    matched += 1
            
            if "connection_rate" in signatures:
                cr = features.connection_rate
                min_c, max_c = signatures["connection_rate"]
                if min_c <= cr <= max_c:
                    score += 1.0
                    matched += 1
            
            if "packet_rate" in signatures:
                pr = features.packet_rate
                min_p, max_p = signatures["packet_rate"]
                if min_p <= pr <= max_p:
                    score += 1.0
                    matched += 1
            
            if matched > 0 and score > best_score:
                best_score = score
                best_match = attack_type
        
        return best_match if best_score >= 2.0 else None
    
    def get_ip_profile(self, ip: str) -> Optional[IPThreatProfile]:
        """Get threat profile for an IP"""
        with self.lock:
            return self.ip_profiles.get(ip)
    
    def get_global_stats(self) -> Dict[str, Any]:
        """Get global statistics"""
        with self.lock:
            return {
                "total_ips": self.global_stats["total_ips"],
                "total_packets": self.global_stats["total_packets"],
                "total_bytes": self.global_stats["total_bytes"],
                "attack_distribution": dict(self.global_stats["attack_types"]),
                "unique_ips_tracked": len(self.ip_profiles)
            }
    
    def get_high_risk_ips(self, threshold: float = 60.0) -> List[IPThreatProfile]:
        """Get IPs with high threat scores"""
        with self.lock:
            high_risk = []
            for profile in self.ip_profiles.values():
                if profile.threat_score >= threshold:
                    high_risk.append(profile)
            return sorted(high_risk, key=lambda x: x.threat_score, reverse=True)


class AnomalyDetector:
    """ML-based anomaly detection using statistical methods"""
    
    def __init__(self):
        self.baseline_stats = {}
        self.anomaly_history: List[Dict] = []
        self.lock = threading.Lock()
        
    def compute_baseline(self, feature_name: str, values: List[float]) -> Dict[str, float]:
        """Compute baseline statistics from historical data"""
        if not values:
            return {}
        
        import statistics
        mean = statistics.mean(values)
        std = statistics.stdev(values) if len(values) > 1 else 0
        median = statistics.median(values)
        p95 = statistics.quantiles(values, n=100)[94] if len(values) >= 100 else max(values)
        
        baseline = {
            "mean": mean,
            "std": std,
            "median": median,
            "p95": p95,
            "min": min(values),
            "max": max(values),
            "count": len(values)
        }
        
        with self.lock:
            self.baseline_stats[feature_name] = baseline
        
        return baseline
    
    def detect_anomaly(self, feature_name: str, value: float, 
                      threshold: float = 3.0) -> Tuple[bool, float, str]:
        """
        Detect if a value is anomalous
        
        Returns:
            Tuple of (is_anomaly, z_score, severity)
        """
        with self.lock:
            baseline = self.baseline_stats.get(feature_name)
        
        if not baseline or baseline["std"] == 0:
            return False, 0.0, "none"
        
        z_score = abs((value - baseline["mean"]) / baseline["std"])
        
        if z_score > threshold * 2:
            return True, z_score, "critical"
        elif z_score > threshold * 1.5:
            return True, z_score, "high"
        elif z_score > threshold:
            return True, z_score, "medium"
        else:
            return False, z_score, "low"
    
    def record_anomaly(self, feature: str, value: float, z_score: float, 
                      severity: str, context: Dict = None):
        """Record detected anomaly"""
        anomaly = {
            "timestamp": datetime.now().isoformat(),
            "feature": feature,
            "value": value,
            "z_score": z_score,
            "severity": severity,
            "context": context or {}
        }
        
        with self.lock:
            self.anomaly_history.append(anomaly)
            
            # Keep last 1000 anomalies
            if len(self.anomaly_history) > 1000:
                self.anomaly_history = self.anomaly_history[-1000:]
        
        logger.warning(f"Anomaly detected: {feature}={value} (z={z_score:.2f}, severity={severity})")
        
        return anomaly
    
    def get_anomaly_summary(self, time_window_minutes: int = 60) -> Dict[str, Any]:
        """Get summary of recent anomalies"""
        cutoff = datetime.now() - timedelta(minutes=time_window_minutes)
        
        with self.lock:
            recent = [a for a in self.anomaly_history 
                     if datetime.fromisoformat(a["timestamp"]) > cutoff]
        
        severity_counts = {"critical": 0, "high": 0, "medium": 0, "low": 0}
        feature_counts = defaultdict(int)
        
        for anomaly in recent:
            severity_counts[anomaly["severity"]] += 1
            feature_counts[anomaly["feature"]] += 1
        
        return {
            "total_anomalies": len(recent),
            "by_severity": dict(severity_counts),
            "by_feature": dict(feature_counts)
        }


class ThreatScoringEngine:
    """Main threat scoring engine combining all components"""
    
    def __init__(self):
        self.behavioral_analyzer = BehavioralAnalyzer()
        self.anomaly_detector = AnomalyDetector()
        self.lock = threading.Lock()
        self.running = False
        
        # Weights for final threat score
        self.weights = {
            "base_score": 0.30,
            "packet_anomaly": 0.20,
            "behavioral_anomaly": 0.20,
            "attack_pattern": 0.15,
            "reputation": 0.15
        }
        
    def start(self):
        """Start the threat scoring engine"""
        self.running = True
        logger.info("Threat scoring engine started")
    
    def stop(self):
        """Stop the threat scoring engine"""
        self.running = False
        logger.info("Threat scoring engine stopped")
    
    def analyze_packet(self, ip: str, protocol: str, size: int, 
                      port: int = 0) -> Dict[str, Any]:
        """Analyze a packet and update threat assessment"""
        with self.lock:
            # Update IP profile
            self.behavioral_analyzer.update_ip_profile(ip, size, protocol)
            
            # Get current features
            profile = self.behavioral_analyzer.get_ip_profile(ip)
            
            if profile:
                # Detect anomalies
                features = profile.features
                
                is_anomaly, z_score, severity = self.anomaly_detector.detect_anomaly(
                    "packet_rate", features.packet_rate
                )
                
                if is_anomaly:
                    self.anomaly_detector.record_anomaly(
                        "packet_rate", features.packet_rate, z_score, severity,
                        {"ip": ip, "protocol": protocol}
                    )
                
                # Compute threat score
                threat_score, threat_level = self.behavioral_analyzer.compute_threat_score(ip)
                
                # Detect attack type
                attack_type = self.behavioral_analyzer.detect_attack_type(features)
                
                return {
                    "ip": ip,
                    "threat_score": threat_score,
                    "threat_level": threat_level.value,
                    "attack_type": attack_type,
                    "features": {
                        "packet_rate": features.packet_rate,
                        "syn_ratio": features.syn_ratio,
                        "udp_ratio": features.udp_ratio
                    },
                    "anomaly_detected": is_anomaly,
                    "anomaly_severity": severity
                }
            
            return {"ip": ip, "threat_score": 0.0, "threat_level": "low"}
    
    def record_attack_detection(self, ip: str, attack_type: str, 
                               blocked: bool = True) -> Dict[str, Any]:
        """Record detection of an attack"""
        with self.lock:
            self.behavioral_analyzer.record_attack(ip, attack_type)
            
            if blocked:
                # Update baseline statistics
                profile = self.behavioral_analyzer.get_ip_profile(ip)
                if profile:
                    self.anomaly_detector.compute_baseline(
                        f"attack_{attack_type}",
                        [profile.total_packets]
                    )
            
            threat_score, threat_level = self.behavioral_analyzer.compute_threat_score(ip)
            
            return {
                "ip": ip,
                "attack_type": attack_type,
                "blocked": blocked,
                "new_threat_score": threat_score,
                "threat_level": threat_level.value
            }
    
    def get_threat_assessment(self, ip: str) -> Dict[str, Any]:
        """Get full threat assessment for an IP"""
        profile = self.behavioral_analyzer.get_ip_profile(ip)
        
        if not profile:
            return {
                "ip": ip,
                "status": "unknown",
                "threat_score": 0.0,
                "threat_level": "low",
                "recommendation": "allow"
            }
        
        # Compute final threat score
        score = self._compute_final_score(profile)
        level = self._score_to_level(score)
        
        # Generate recommendation
        recommendation = self._generate_recommendation(score, profile)
        
        return {
            "ip": ip,
            "status": "known",
            "first_seen": profile.first_seen.isoformat(),
            "last_seen": profile.last_seen.isoformat(),
            "total_packets": profile.total_packets,
            "total_bytes": profile.total_bytes,
            "attack_history": profile.attack_types,
            "blocked_count": profile.blocked_count,
            "threat_score": score,
            "threat_level": level.value,
            "recommendation": recommendation,
            "is_whitelisted": profile.is_whitelisted,
            "is_blacklisted": profile.is_blacklisted
        }
    
    def _compute_final_score(self, profile: IPThreatProfile) -> float:
        """Compute final threat score with weights"""
        score = 0.0
        
        # Base behavioral score
        base = profile.threat_score * self.weights["base_score"]
        score += base
        
        # Packet anomaly component
        features = profile.features
        if features.packet_rate > 0:
            z_score = self.anomaly_detector.packet_rate_analyzer.get_z_score(
                features.packet_rate
            )
            score += min(abs(z_score) / 3 * 100 * self.weights["packet_anomaly"], 100)
        
        # Behavioral anomaly
        score += features.behavioral_anomaly * self.weights["behavioral_anomaly"] * 100
        
        # Attack pattern
        if profile.attack_types:
            pattern_score = min(len(profile.attack_types) * 10, 100)
            score += pattern_score * self.weights["attack_pattern"]
        
        # Reputation (inverted score)
        rep_component = (1.0 - features.reputation_score) * 100
        score += rep_component * self.weights["reputation"]
        
        return min(score, 100.0)
    
    def _score_to_level(self, score: float) -> ThreatLevel:
        """Convert numerical score to threat level"""
        if score >= 80:
            return ThreatLevel.CRITICAL
        elif score >= 60:
            return ThreatLevel.HIGH
        elif score >= 40:
            return ThreatLevel.MEDIUM
        else:
            return ThreatLevel.LOW
    
    def _generate_recommendation(self, score: float, profile: IPThreatProfile) -> str:
        """Generate action recommendation based on threat score"""
        if profile.is_whitelisted:
            return "allow"
        
        if profile.is_blacklisted:
            return "block"
        
        if score >= 80:
            return "block_immediately"
        elif score >= 60:
            return "block"
        elif score >= 40:
            return "challenge"  # CAPTCHA, rate limit, etc.
        else:
            return "allow"
    
    def get_dashboard_data(self) -> Dict[str, Any]:
        """Get data for dashboard display"""
        global_stats = self.behavioral_analyzer.get_global_stats()
        anomaly_summary = self.anomaly_detector.get_anomaly_summary()
        high_risk = self.behavioral_analyzer.get_high_risk_ips(60.0)
        
        return {
            "global_stats": global_stats,
            "anomaly_summary": anomaly_summary,
            "high_risk_count": len(high_risk),
            "top_threats": [p.to_dict() for p in high_risk[:10]],
            "engine_status": "running" if self.running else "stopped"
        }


class ThreatModelTrainer:
    """Trains threat detection models from historical data"""
    
    def __init__(self):
        self.training_data: List[Dict] = []
        self.model_weights: Dict[str, float] = {}
        
    def add_training_sample(self, features: Dict, label: str):
        """Add a labeled training sample"""
        self.training_data.append({
            "features": features,
            "label": label,
            "timestamp": datetime.now().isoformat()
        })
    
    def train_simple_model(self) -> Dict[str, float]:
        """
        Train a simple weighted model from training data
        Uses heuristic-based training for demonstration
        """
        if not self.training_data:
            logger.warning("No training data available")
            return {}
        
        # Calculate feature importance based on correlation with labels
        feature_importance = defaultdict(list)
        
        for sample in self.training_data:
            features = sample["features"]
            label = sample["label"]
            
            # Convert label to numeric
            if label in ["critical", "high"]:
                numeric_label = 1.0
            elif label == "medium":
                numeric_label = 0.5
            else:
                numeric_label = 0.0
            
            for feature, value in features.items():
                feature_importance[feature].append((value, numeric_label))
        
        # Calculate correlation for each feature
        model_weights = {}
        for feature, values in feature_importance.items():
            if len(values) > 1:
                # Simple correlation calculation
                feature_values = [v[0] for v in values]
                labels = [v[1] for v in values]
                
                mean_f = sum(feature_values) / len(feature_values)
                mean_l = sum(labels) / len(labels)
                
                covariance = sum((f - mean_f) * (l - mean_l) for f, l in zip(feature_values, labels))
                variance_f = sum((f - mean_f) ** 2 for f in feature_values)
                
                if variance_f > 0:
                    correlation = covariance / variance_f
                    model_weights[feature] = max(0.0, min(1.0, correlation))
        
        self.model_weights = model_weights
        logger.info(f"Trained model with {len(model_weights)} features")
        
        return model_weights
    
    def predict(self, features: Dict) -> float:
        """Predict threat score using trained model"""
        if not self.model_weights:
            return 0.0
        
        score = 0.0
        for feature, weight in self.model_weights.items():
            value = features.get(feature, 0.0)
            score += value * weight
        
        return min(score, 100.0)


